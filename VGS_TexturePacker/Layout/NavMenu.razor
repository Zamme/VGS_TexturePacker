            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="crearmapas">
                <span class="bi bi-grid-3x3-gap" aria-hidden="true"></span> Create Maps
            </NavLink>
        </div>
        <div class="nav-item px-3">
