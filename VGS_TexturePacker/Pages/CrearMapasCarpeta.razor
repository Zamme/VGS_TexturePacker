@page "/crearmapascarpeta"
@inject IJSRuntime JS

<PageTitle>Create Maps Folder</PageTitle>

<h1>Create Maps Folder</h1>

<p>Select a folder with diffuse textures. AO, Roughness, and Gloss maps will be generated for each image in a new folder named Maps+CurrentTime.</p>

<div class="mt-4 border rounded p-3">
    <h5>Generation Settings</h5>

    <div class="mb-3">
        <label class="form-label" for="aoStrengthFolderRange">AO Intensity: @aoStrengthPercent%</label>
        <input id="aoStrengthFolderRange" type="range" class="form-range" min="0" max="200" @bind="aoStrengthPercent" @bind:event="oninput" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="roughnessContrastFolderRange">Roughness Contrast: @roughnessContrastPercent%</label>
        <input id="roughnessContrastFolderRange" type="range" class="form-range" min="0" max="200" @bind="roughnessContrastPercent" @bind:event="oninput" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="metallicThresholdFolderRange">Metallic Threshold: @metallicThresholdPercent%</label>
        <input id="metallicThresholdFolderRange" type="range" class="form-range" min="0" max="100" @bind="metallicThresholdPercent" @bind:event="oninput" />
    </div>

    <div class="mb-0">
        <label class="form-label" for="metallicIntensityFolderRange">Metallic Intensity: @metallicIntensityPercent%</label>
        <input id="metallicIntensityFolderRange" type="range" class="form-range" min="0" max="200" @bind="metallicIntensityPercent" @bind:event="oninput" />
    </div>
</div>

<div class="mt-3 mb-3">
    <button class="btn btn-primary" @onclick="ProcessFolderAsync" disabled="@(!directoryPickerSupported || isProcessing)">
        @((isProcessing) ? "Processing folder..." : "Select folder and create maps")
    </button>
</div>

@if (!directoryPickerSupported)
{
    <p class="text-warning">This browser does not support direct folder selection (showDirectoryPicker).</p>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3">@statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger mt-3">@errorMessage</p>
}

@if (lastResult is not null)
{
    <div class="mt-4 border rounded p-3">
        <h4 class="mb-3">Processing Result</h4>
        <p class="mb-1"><strong>Detected Images:</strong> @lastResult.TotalImages</p>
        <p class="mb-1"><strong>Processed Images:</strong> @lastResult.ProcessedCount</p>
        <p class="mb-1"><strong>Skipped Images:</strong> @lastResult.SkippedCount</p>

        @if (!string.IsNullOrWhiteSpace(lastResult.OutputFolderName))
        {
            <p class="mb-2"><strong>Output Folder:</strong> @lastResult.OutputFolderName</p>
        }

        @if (lastResult.Errors?.Count > 0)
        {
            <h5 class="mt-3">Error Details</h5>
            <ul class="mb-0">
                @foreach (var err in lastResult.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        }
    </div>
}

@code {
    private bool directoryPickerSupported = true;
    private bool isProcessing;
    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;
    private CreateMapsFolderResult? lastResult;
    private int aoStrengthPercent = 100;
    private int roughnessContrastPercent = 100;
    private int metallicThresholdPercent = 50;
    private int metallicIntensityPercent = 60;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        directoryPickerSupported = await JS.InvokeAsync<bool>("ormBuilder.supportsDirectoryPicker");
        if (!directoryPickerSupported)
        {
            StateHasChanged();
        }
    }

    private async Task ProcessFolderAsync()
    {
        isProcessing = true;
        statusMessage = "Select a folder to start processing...";
        errorMessage = string.Empty;
        lastResult = null;

        try
        {
            var result = await JS.InvokeAsync<CreateMapsFolderResult>(
                "ormBuilder.processFolderCreateMaps",
                aoStrengthPercent / 100.0,
                roughnessContrastPercent / 100.0,
                metallicThresholdPercent / 100.0,
                metallicIntensityPercent / 100.0);

            if (result is null)
            {
                errorMessage = "No response received from folder processing.";
                return;
            }

            lastResult = result;

            if (!result.Success)
            {
                errorMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Could not complete folder processing."
                    : result.ErrorMessage;
                return;
            }

            statusMessage = "Processing completed. Check the summary to see how many images were converted.";
        }
        catch
        {
            errorMessage = "Could not process the selected folder.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private sealed class CreateMapsFolderResult
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
        public int TotalImages { get; set; }
        public int ProcessedCount { get; set; }
        public int SkippedCount { get; set; }
        public string OutputFolderName { get; set; } = string.Empty;
        public List<string> Errors { get; set; } = new();
    }
}