@page "/exportarextensionarchivo"
@inject IJSRuntime JS

<h1>Export File</h1>

<p>Convert an image to the selected extension (PNG or WebP).</p>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 d-grid">
        <button class="btn btn-outline-primary" @onclick="SelectSourceFileAsync" disabled="@(!openFilePickerSupported || isProcessing)">
            Select Source File
        </button>
    </div>
    <div class="col-12 col-md-6 d-grid">
        <button class="btn btn-outline-primary" @onclick="SelectDestinationFolderAsync" disabled="@(!directoryPickerSupported || isProcessing)">
            Select Destination Folder
        </button>
    </div>
</div>

<div class="mb-3">
    <p class="mb-1"><strong>Source:</strong> @GetSourceStatusText()</p>
    <p class="mb-1"><strong>Destination:</strong> @GetDestinationStatusText()</p>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label" for="outputExtension">Output Extension</label>
        <select id="outputExtension" class="form-select" @bind="selectedExtension" @bind:after="OnExtensionChanged">
            <option value="">Select an extension</option>
            <option value="png">png</option>
            <option value="webp">webp</option>
        </select>
    </div>

    @if (RequiresLossy)
    {
        <div class="col-12 col-md-8">
            <label class="form-label" for="webpLossy">Lossy WebP (%)</label>
            <input id="webpLossy" type="range" class="form-range" min="1" max="100" step="1" @bind="webpLossyPercent" />
            <div>@webpLossyPercent%</div>
        </div>
    }
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ProcessAsync" disabled="@(!CanProcess)">
        @(isProcessing ? "Processing..." : "Process")
    </button>
</div>

@if (!openFilePickerSupported)
{
    <p class="text-warning">This browser does not support direct file selection (showOpenFilePicker).</p>
}

@if (!directoryPickerSupported)
{
    <p class="text-warning">This browser does not support direct folder selection (showDirectoryPicker).</p>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3">@statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger mt-3">@errorMessage</p>
}

@if (lastResult is not null)
{
    <div class="mt-4 border rounded p-3">
        <h4 class="mb-3">Export Result</h4>
        <p class="mb-1"><strong>Selected File:</strong> @lastResult.TotalCandidates</p>
        <p class="mb-1"><strong>Exported:</strong> @lastResult.ProcessedCount</p>
        <p class="mb-2"><strong>Skipped:</strong> @lastResult.SkippedCount</p>

        @if (lastResult.Errors?.Count > 0)
        {
            <h5 class="mt-3">Error Details</h5>
            <ul class="mb-0">
                @foreach (var err in lastResult.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        }
    </div>
}

@code {
    private bool directoryPickerSupported = true;
    private bool openFilePickerSupported = true;
    private bool isProcessing;

    private bool hasSourceFile;
    private bool hasDestinationFolder;
    private bool destinationIsEmpty;

    private string? sourceFileName;
    private string? destinationFolderName;

    private string selectedExtension = string.Empty;
    private int webpLossyPercent = 80;

    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;
    private ExtensionExportResult? lastResult;

    private bool RequiresLossy => selectedExtension.Equals("webp", StringComparison.OrdinalIgnoreCase);

    private bool CanProcess =>
        openFilePickerSupported
        && directoryPickerSupported
        && !isProcessing
        && hasSourceFile
        && hasDestinationFolder
        && IsExtensionValid();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        directoryPickerSupported = await JS.InvokeAsync<bool>("ormBuilder.supportsDirectoryPicker");
        openFilePickerSupported = await JS.InvokeAsync<bool>("ormBuilder.supportsOpenFilePicker");

        if (!directoryPickerSupported || !openFilePickerSupported)
        {
            StateHasChanged();
        }
    }

    private async Task SelectSourceFileAsync()
    {
        errorMessage = string.Empty;
        statusMessage = string.Empty;

        try
        {
            var result = await JS.InvokeAsync<FileSelectionResult>("ormBuilder.selectExportExtensionSourceFile");
            if (result is null)
            {
                errorMessage = "Could not select the source file.";
                return;
            }

            if (!result.Success)
            {
                if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
                {
                    errorMessage = result.ErrorMessage;
                }

                return;
            }

            hasSourceFile = true;
            sourceFileName = result.FileName;
            statusMessage = "Source file selected.";
        }
        catch
        {
            errorMessage = "Could not select the source file.";
        }
    }

    private async Task SelectDestinationFolderAsync()
    {
        errorMessage = string.Empty;
        statusMessage = string.Empty;

        try
        {
            var result = await JS.InvokeAsync<DirectorySelectionResult>("ormBuilder.selectExportExtensionDestinationFolder");
            if (result is null)
            {
                errorMessage = "Could not select the destination folder.";
                return;
            }

            if (!result.Success)
            {
                if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
                {
                    errorMessage = result.ErrorMessage;
                }

                return;
            }

            hasDestinationFolder = true;
            destinationFolderName = result.DirectoryName;
            destinationIsEmpty = result.IsEmpty;


            if (destinationIsEmpty)
            {
                statusMessage = "Destination folder selected and empty.";
            }
            else
            {
                statusMessage = "Destination folder selected, but it contains files or folders.";
            }
        }
        catch
        {
            errorMessage = "Could not select the destination folder.";
        }
    }

    private Task OnExtensionChanged()
    {
        errorMessage = string.Empty;
        statusMessage = string.Empty;
        return Task.CompletedTask;
    }

    private async Task ProcessAsync()
    {
        if (!CanProcess)
        {
            return;
        }

        isProcessing = true;
        errorMessage = string.Empty;
        statusMessage = "Processing file...";
        lastResult = null;

        try
        {
            var normalizedExtension = selectedExtension.Trim().ToLowerInvariant();
            var lossyAsQuality = RequiresLossy
                ? webpLossyPercent / 100.0
                : 1.0;

            var result = await JS.InvokeAsync<ExtensionExportResult>(
                "ormBuilder.processExportExtensionFile",
                normalizedExtension,
                lossyAsQuality);

            if (result is null)
            {
                errorMessage = "No response received from the exporter.";
                return;
            }

            lastResult = result;

            if (!result.Success)
            {
                errorMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Could not complete the export."
                    : result.ErrorMessage;
            }
            else
            {
                statusMessage = "Export completed.";
            }
        }
        catch
        {
            errorMessage = "Could not process the export.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private bool IsExtensionValid()
    {
        if (selectedExtension.Equals("png", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (selectedExtension.Equals("webp", StringComparison.OrdinalIgnoreCase))
        {
            return webpLossyPercent >= 1 && webpLossyPercent <= 100;
        }

        return false;
    }

    private string GetSourceStatusText()
    {
        if (!hasSourceFile)
        {
            return "Not selected";
        }

        return string.IsNullOrWhiteSpace(sourceFileName) ? "Selected" : sourceFileName;
    }

    private string GetDestinationStatusText()
    {
        if (!hasDestinationFolder)
        {
            return "Not selected";
        }

        var folderLabel = string.IsNullOrWhiteSpace(destinationFolderName)
            ? "Selected"
            : destinationFolderName;

        var emptyLabel = destinationIsEmpty ? "empty" : "not empty";
        return $"{folderLabel} ({emptyLabel})";
    }

    private sealed class FileSelectionResult
    {
        public bool Success { get; set; }
        public string? FileName { get; set; }
        public string? ErrorMessage { get; set; }
    }

    private sealed class DirectorySelectionResult
    {
        public bool Success { get; set; }
        public bool IsEmpty { get; set; }
        public string? DirectoryName { get; set; }
        public string? ErrorMessage { get; set; }
    }

    private sealed class ExtensionExportResult
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
        public int TotalCandidates { get; set; }
        public int ProcessedCount { get; set; }
        public int SkippedCount { get; set; }
        public List<string> Errors { get; set; } = new();
    }
}
