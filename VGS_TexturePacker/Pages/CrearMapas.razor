@page "/crearmapas"
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
@using System.IO

<PageTitle>Create Maps</PageTitle>

<h1>Create Maps</h1>

<p>Upload a diffuse texture (base color) and the Ambient Occlusion, Roughness, Metallic, and Normal maps will be generated automatically.</p>

<div class="mb-3">
    <label class="btn btn-primary">
        Upload diffuse texture
        <InputFile OnChange="OnDiffuseSelectedAsync" accept="image/*" class="d-none" />
    </label>
</div>

@if (!string.IsNullOrWhiteSpace(diffuseFileName))
{
    <p class="mb-2"><strong>Loaded texture:</strong> @diffuseFileName</p>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(diffusePreview))
{
    <div class="mt-4">
        <h4>Diffuse Texture</h4>
        <img src="@diffusePreview" alt="Diffuse Texture" class="img-fluid rounded border" />

        <div class="mt-4 border rounded p-3">
            <h5>Generation Settings</h5>

            <div class="mb-3">
                <label class="form-label" for="aoStrengthRange">AO Intensity: @aoStrengthPercent%</label>
                <input id="aoStrengthRange" type="range" class="form-range" min="0" max="200" @bind="aoStrengthPercent" @bind:event="oninput" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="roughnessContrastRange">Roughness Contrast: @roughnessContrastPercent%</label>
                <input id="roughnessContrastRange" type="range" class="form-range" min="0" max="200" @bind="roughnessContrastPercent" @bind:event="oninput" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="metallicThresholdRange">Metallic Threshold: @metallicThresholdPercent%</label>
                <input id="metallicThresholdRange" type="range" class="form-range" min="0" max="100" @bind="metallicThresholdPercent" @bind:event="oninput" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="metallicIntensityRange">Metallic Intensity: @metallicIntensityPercent%</label>
                <input id="metallicIntensityRange" type="range" class="form-range" min="0" max="200" @bind="metallicIntensityPercent" @bind:event="oninput" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="normalStrengthRange">Normal Strength: @normalStrengthPercent%</label>
                <input id="normalStrengthRange" type="range" class="form-range" min="0" max="300" @bind="normalStrengthPercent" @bind:event="oninput" />
            </div>

            <button class="btn btn-secondary" @onclick="RegenerateMapsAsync">Regenerate Maps</button>
        </div>
    </div>
}

@if (HasGeneratedMaps)
{
    <div class="mt-4">
        <h4>Generated Maps</h4>
        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <h5>Ambient Occlusion</h5>
                    <img src="@aoPreview" alt="Ambient Occlusion Map" class="img-fluid rounded border mb-3" />
                    <button class="btn btn-outline-primary w-100" @onclick='() => DownloadMapAsync(aoPreview, "AO")'>Download AO</button>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <h5>Roughness</h5>
                    <img src="@roughnessPreview" alt="Roughness Map" class="img-fluid rounded border mb-3" />
                    <button class="btn btn-outline-primary w-100" @onclick='() => DownloadMapAsync(roughnessPreview, "Roughness")'>Download Roughness</button>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <h5>Metallic</h5>
                    <img src="@metallicPreview" alt="Metallic Map" class="img-fluid rounded border mb-3" />
                    <button class="btn btn-outline-primary w-100" @onclick='() => DownloadMapAsync(metallicPreview, "Metallic")'>Download Metallic</button>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="border rounded p-3 h-100">
                    <h5>Normal</h5>
                    <img src="@normalPreview" alt="Normal Map" class="img-fluid rounded border mb-3" />
                    <button class="btn btn-outline-primary w-100" @onclick='() => DownloadMapAsync(normalPreview, "Normal")'>Download Normal</button>
                </div>
            </div>
        </div>

        <button class="btn btn-success mt-3" @onclick="DownloadAllAsync">Download All</button>
    </div>
}

@code {
    private const long MaxImageSizeBytes = 20 * 1024 * 1024;

    private string diffusePreview = string.Empty;
    private string diffuseFileName = string.Empty;
    private string diffuseBaseName = "texture";
    private string aoPreview = string.Empty;
    private string roughnessPreview = string.Empty;
    private string metallicPreview = string.Empty;
    private string normalPreview = string.Empty;
    private string errorMessage = string.Empty;
    private int aoStrengthPercent = 100;
    private int roughnessContrastPercent = 100;
    private int metallicThresholdPercent = 50;
    private int metallicIntensityPercent = 60;
    private int normalStrengthPercent = 120;

    private bool HasGeneratedMaps =>
        !string.IsNullOrWhiteSpace(aoPreview)
        && !string.IsNullOrWhiteSpace(roughnessPreview)
        && !string.IsNullOrWhiteSpace(metallicPreview)
        && !string.IsNullOrWhiteSpace(normalPreview);

    private async Task OnDiffuseSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;

        ResetGeneratedMaps();
        errorMessage = string.Empty;

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "The selected file is not a valid image.";
            diffusePreview = string.Empty;
            diffuseFileName = string.Empty;
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxImageSizeBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var bytes = memoryStream.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            diffusePreview = $"data:{file.ContentType};base64,{base64}";
            diffuseFileName = file.Name;
            diffuseBaseName = Path.GetFileNameWithoutExtension(file.Name);

            await GenerateMapsFromCurrentSettingsAsync();
        }
        catch
        {
            errorMessage = "Error while processing the diffuse texture.";
            ResetGeneratedMaps();
        }
    }

    private async Task DownloadMapAsync(string dataUrl, string mapType)
    {
        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            return;
        }

        var fileName = $"{diffuseBaseName}_{mapType}.png";
        await JS.InvokeAsync<bool>(
            "ormBuilder.downloadWithFormat",
            dataUrl,
            fileName,
            "png",
            1.0,
            false);
    }

    private async Task DownloadAllAsync()
    {
        if (!HasGeneratedMaps)
        {
            return;
        }

        await DownloadMapAsync(aoPreview, "AO");
        await DownloadMapAsync(roughnessPreview, "Roug");
        await DownloadMapAsync(metallicPreview, "Glos");
        await DownloadMapAsync(normalPreview, "Norm");
    }

    private async Task RegenerateMapsAsync()
    {
        await GenerateMapsFromCurrentSettingsAsync();
    }

    private async Task GenerateMapsFromCurrentSettingsAsync()
    {
        if (string.IsNullOrWhiteSpace(diffusePreview))
        {
            return;
        }

        errorMessage = string.Empty;

        try
        {
            var generated = await JS.InvokeAsync<GeneratedMapsResult>(
                "ormBuilder.createMapsFromDiffuse",
                diffusePreview,
                aoStrengthPercent / 100.0,
                roughnessContrastPercent / 100.0,
                metallicThresholdPercent / 100.0,
                metallicIntensityPercent / 100.0,
                normalStrengthPercent / 100.0);

            if (generated is null
                || string.IsNullOrWhiteSpace(generated.Ao)
                || string.IsNullOrWhiteSpace(generated.Roughness)
                || string.IsNullOrWhiteSpace(generated.Metallic)
                || string.IsNullOrWhiteSpace(generated.Normal))
            {
                errorMessage = "Could not generate maps with the current settings.";
                ResetGeneratedMaps();
                return;
            }

            aoPreview = generated.Ao;
            roughnessPreview = generated.Roughness;
            metallicPreview = generated.Metallic;
            normalPreview = generated.Normal;
        }
        catch
        {
            errorMessage = "Could not regenerate maps.";
            ResetGeneratedMaps();
        }
    }

    private void ResetGeneratedMaps()
    {
        aoPreview = string.Empty;
        roughnessPreview = string.Empty;
        metallicPreview = string.Empty;
        normalPreview = string.Empty;
    }

    private sealed class GeneratedMapsResult
    {
        public string Ao { get; set; } = string.Empty;
        public string Roughness { get; set; } = string.Empty;
        public string Metallic { get; set; } = string.Empty;
        public string Normal { get; set; } = string.Empty;
    }
}
