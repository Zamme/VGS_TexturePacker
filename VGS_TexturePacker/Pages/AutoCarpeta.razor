@page "/autocarpeta"
@inject IJSRuntime JS

<PageTitle>Create ORM Folder</PageTitle>

<h1>Create ORM Folder</h1>

<p>Select a folder, the system will search for AO, Roughness, and Metallic maps and generate ORM textures in a subfolder named ORMs.</p>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label" for="outputFormatFolder">Output Format</label>
        <select id="outputFormatFolder" class="form-select" @bind="selectedOutputFormat">
            <option value="png">PNG</option>
            <option value="webp">WebP (Lossy 80%)</option>
        </select>
    </div>
    <div class="col-12 col-md-8 d-flex align-items-end">
        <button class="btn btn-primary" @onclick="ProcessFolderAsync" disabled="@(!directoryPickerSupported || isProcessing)">
            @((isProcessing) ? "Processing folder..." : "Select folder and generate ORMs")
        </button>
    </div>
</div>

@if (!directoryPickerSupported)
{
    <p class="text-warning">This browser does not support direct folder access (showDirectoryPicker).</p>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3">@statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger mt-3">@errorMessage</p>
}

@if (lastResult is not null)
{
    <div class="mt-4 border rounded p-3">
        <h4 class="mb-3">Processing Result</h4>
        <p class="mb-1"><strong>Detected Groups:</strong> @lastResult.TotalGroups</p>
        <p class="mb-1"><strong>Created ORMs:</strong> @lastResult.CreatedCount</p>
        <p class="mb-2"><strong>Skipped Items:</strong> @lastResult.SkippedCount</p>

        @if (lastResult.Errors?.Count > 0)
        {
            <h5 class="mt-3">Error Details</h5>
            <ul class="mb-0">
                @foreach (var err in lastResult.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        }
    </div>
}

@code {
    private string selectedOutputFormat = "png";
    private bool directoryPickerSupported = true;
    private bool isProcessing;
    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;
    private AutoFolderProcessResult? lastResult;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        directoryPickerSupported = await JS.InvokeAsync<bool>("ormBuilder.supportsDirectoryPicker");
        if (!directoryPickerSupported)
        {
            StateHasChanged();
        }
    }

    private async Task ProcessFolderAsync()
    {
        isProcessing = true;
        statusMessage = "Select a folder to start processing...";
        errorMessage = string.Empty;
        lastResult = null;

        try
        {
            var extension = selectedOutputFormat.Equals("webp", StringComparison.OrdinalIgnoreCase)
                ? "webp"
                : "png";

            var quality = extension == "webp" ? 0.8 : 1.0;

            var result = await JS.InvokeAsync<AutoFolderProcessResult>(
                "ormBuilder.processFolderToOrm",
                extension,
                quality);

            if (result is null)
            {
                errorMessage = "No response received from folder processing.";
                return;
            }

            lastResult = result;
            if (!result.Success)
            {
                errorMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Could not complete the folder processing."
                    : result.ErrorMessage;
            }
            else
            {
                statusMessage = "Processing completed. Check the summary to see the files created in the ORMs folder.";
            }
        }
        catch
        {
            errorMessage = "Could not process the selected folder.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private sealed class AutoFolderProcessResult
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
        public int TotalGroups { get; set; }
        public int CreatedCount { get; set; }
        public int SkippedCount { get; set; }
        public List<string> Errors { get; set; } = new();
    }
}
